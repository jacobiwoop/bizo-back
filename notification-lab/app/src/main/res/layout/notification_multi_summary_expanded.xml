<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_avatar_1"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/avatar_bg_warm"
            android:gravity="center"
            android:text="AK"
            android:textColor="#7C4A18"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summary_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Akatsuki &lt;/&gt; Dev  Muka'z : Photo"
                android:textColor="#F1F1F1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_preview_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Photo envoyee"
                android:textColor="#D8D2CA"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/summary_chevron_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_avatar_2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/avatar_bg_blue"
            android:gravity="center"
            android:text="JW"
            android:textColor="#2F66F3"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summary_text_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="jacobi • maintenant"
                android:textColor="#F1F1F1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_preview_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Bonjour mon grand comment..."
                android:textColor="#D8D2CA"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/summary_chevron_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/summary_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repondre"
            android:textColor="#FFB476"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_mark_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="Marquer comme lu"
            android:textColor="#FFB476"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_silence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="Silence"
            android:textColor="#FFB476"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_avatar_3"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/avatar_bg_dark"
            android:gravity="center"
            android:text="RS"
            android:textColor="#F1F1F1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summary_text_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ressi • 2 min"
                android:textColor="#F1F1F1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_preview_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Merci"
                android:textColor="#D8D2CA"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/summary_chevron_3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>
</LinearLayout>
