                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="jacobi • maintenant"
                android:textColor="#F1F1F1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
