                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Bonjour mon grand comment..."
                android:textColor="#D8D2CA"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
