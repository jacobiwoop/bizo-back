<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="4dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/summary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Bizo • 3 messages de 2 discussions • maintenant"
        android:textColor="#D8D2CA"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_avatar_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/avatar_bg_warm"
            android:gravity="center"
            android:text="AK"
            android:textColor="#7C4A18"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Akatsuki &lt;/&gt; Dev  Muka'z : Photo"
            android:textColor="#F1F1F1"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary_avatar_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/avatar_bg_blue"
            android:gravity="center"
            android:text="JW"
            android:textColor="#2F66F3"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="jacobi  Bonjour mon grand comment..."
            android:textColor="#F1F1F1"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
