{
  "expo": {
    "name": "Bizo",
    "slug": "bizo-mobile-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bizo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.bizo.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Bizo utilise l'appareil photo pour publier des annonces.",
        "NSLocationWhenInUseUsageDescription": "Bizo utilise votre position pour localiser les annonces proches.",
        "NSUserTrackingUsageDescription": "Bizo utilise certaines donnees pour ameliorer l'experience de navigation."
      }
    },
    "android": {
      "package": "io.bizo.woop",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-native-startup-animation",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#111111"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bizo accede a vos photos pour publier vos annonces.",
          "cameraPermission": "Bizo accede a l'appareil photo pour prendre les photos de vos annonces."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bizo utilise votre position pour localiser les annonces et simplifier la publication."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bizo accede a l'appareil photo pour capturer des photos d'annonces."
        }
      ]
    ]
  }
}
