MOBILE_APK_BUILD_SCRIPT_PATH=/app/scripts/build-mobile-apk.sh
MOBILE_APK_BUILD_LOG_PATH=/app/storage/mobile-builds/build.log
MOBILE_APK_BUILD_TOKEN=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
